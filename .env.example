# Copy to .env (git-ignored) and set a real password.
POSTGRES_USER=chess
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chess
CORS_ORIGIN=http://localhost
RUST_LOG=info
# Host port for Postgres (loopback only); change if 5432 is taken
POSTGRES_PORT=5432
# Only for running the backend outside Docker (cargo run) and `cargo sqlx prepare`:
DATABASE_URL=postgres://chess:change-me@localhost:5432/chess

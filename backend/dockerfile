# ---- Builder ----
FROM rust:1.80-slim as builder

WORKDIR /app

# sqlx query! macros are checked offline against the committed .sqlx/ metadata
ENV SQLX_OFFLINE=true

# Installer Rust nightly
RUN rustup install nightly && rustup default nightly

# Installer sqlx-cli (postgres uniquement)
RUN cargo install sqlx-cli --no-default-features --features rustls,postgres

# Copier seulement Cargo.toml pour build des deps en cache
COPY Cargo.toml ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo +nightly build --release || true

# Copier tout le code
COPY . .

# Compiler le binaire final (touch: force cargo a recompiler le vrai main.rs, sinon il garde le binaire factice du cache)
RUN touch src/main.rs && cargo +nightly build --release

# ---- Runtime ----
FROM debian:bookworm-slim

# Installer dépendances runtime
RUN apt-get update && apt-get install -y \
    stockfish \
    postgresql-client \
    curl \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Default runtime envs (can be overridden by compose)
ENV RUST_LOG=info

# Copier sqlx-cli et le backend depuis builder
COPY --from=builder /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx
COPY --from=builder /app/target/release/chess-backend /app/chess-backend

# Copier les migrations
COPY ./migrations ./migrations

# Dossier data (logs de démarrage)
RUN mkdir -p /app/data && chmod 777 /app/data

EXPOSE 8080

# Lancer le backend
CMD ["./chess-backend"]
